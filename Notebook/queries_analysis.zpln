=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>MONTH</th>\n      <th>OP_UNIQUE_CARRIER</th>\n      <th>dep_delay_mean</th>\n      <th>dep_delay_min</th>\n      <th>dep_delay_max</th>\n      <th>cancellation_rate</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>2</td>\n      <td>AA</td>\n      <td>13.301417</td>\n      <td>-27.0</td>\n      <td>3403.0</td>\n      <td>1.323774</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2</td>\n      <td>DL</td>\n      <td>11.354739</td>\n      <td>-30.0</td>\n      <td>1222.0</td>\n      <td>0.229908</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>1</td>\n      <td>AA</td>\n      <td>13.000567</td>\n      <td>-34.0</td>\n      <td>3298.0</td>\n      <td>3.731622</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>1</td>\n      <td>DL</td>\n      <td>12.974122</td>\n      <td>-30.0</td>\n      <td>1209.0</td>\n      <td>2.800566</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>4</td>\n      <td>AA</td>\n      <td>16.012785</td>\n      <td>-28.0</td>\n      <td>2595.0</td>\n      <td>1.432027</td>\n    </tr>\n  </tbody>\n</table>\n</div>"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://0e28052ddd31:4040/jobs/job?id=3"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1779979757653_1894365362","id":"paragraph_1779721595838_1942771984","dateCreated":"2026-05-28T14:49:17+0000","status":"FINISHED","dateFinished":"2026-05-28T14:51:09+0000","dateStarted":"2026-05-28T14:51:08+0000"},{"text":"%spark.pyspark\r\n\r\nimport matplotlib.pyplot as plt\r\n\r\n#path = Path('/queries/queries/query1.csv')\r\n#df = pd.read_csv(path)\r\n\r\nmetrics = ['dep_delay_mean', 'cancellation_rate']\r\ncarriers = ['AA', 'DL']\r\nmonth_order = [1, 2, 3, 4]\r\n\r\nfig, axes = plt.subplots(1, 2, figsize=(12, 5), sharex=True)\r\n\r\nfor ax, metric in zip(axes, metrics):\r\n    for carrier in carriers:\r\n        sub = (\r\n            df[df['OP_UNIQUE_CARRIER'] == carrier]\r\n            .sort_values('MONTH')\r\n        )\r\n        ax.plot(\r\n            sub['MONTH'],\r\n            sub[metric],\r\n            marker='o',\r\n            linewidth=2,\r\n            label=carrier\r\n        )\r\n\r\n    ax.set_title(metric)\r\n    ax.set_xlabel('MONTH')\r\n    ax.set_xticks(month_order)\r\n    ax.grid(True, alpha=0.3)\r\n\r\naxes[0].set_ylabel('Valore')\r\naxes[0].legend(title='Carrier')\r\n\r\nplt.tight_layout()\r\nz.show(plt)\r\nplt.close()","user":"anonymous","dateUpdated":"2026-05-28T14:51:14+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Matplotlib created a temporary config/cache directory at /tmp/matplotlib-56xrd7nl because the default path (/opt/zeppelin/.cache/matplotlib) is not a writable directory; it is highly recommended to set the MPLCONFIGDIR environment variable to a writable directory, in particular to speed up the import of Matplotlib and to better support multiprocessing.\n"},{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1779979757653_1804157632","id":"paragraph_1779717082187_1193479135","dateCreated":"2026-05-28T14:49:17+0000","status":"FINISHED","focus":false,"dateFinished":"2026-05-28T14:51:15+0000","dateStarted":"2026-05-28T14:51:14+0000"},{"text":"%spark.pyspark\ndf = spark.read.option(\"header\", \"true\") \\\n    .option(\"inferSchema\", \"true\") \\\n    .csv(\"hdfs://master:54310/user/root/data/output/query2.csv\")\n\ndf.head()","user":"anonymous","dateUpdated":"2026-05-28T14:51:29+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Row(OP_UNIQUE_CARRIER='OH', n_flights=78476.0, arr_delay_mean=17.155741882868647, carrier_delay_mean=25.977061914553346, weather_delay_mean=5.957642220699109, nas_delay_mean=11.856888279643591, security_delay_mean=0.11601553575508339, late_aircraft_delay_mean=43.50929860635138)"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://0e28052ddd31:4040/jobs/job?id=4"},{"jobUrl":"http://0e28052ddd31:4040/jobs/job?id=5"},{"jobUrl":"http://0e28052ddd31:4040/jobs/job?id=6"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1779979757655_1739111547","id":"paragraph_1779721843121_420691773","dateCreated":"2026-05-28T14:49:17+0000","status":"FINISHED","focus":false,"dateFinished":"2026-05-28T14:51:30+0000","dateStarted":"2026-05-28T14:51:29+0000"},{"text":"%spark.pyspark\nimport pandas as pd\ndf = df.toPandas() \ndf.head()\n","user":"anonymous","dateUpdated":"2026-05-28T14:51:32+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>OP_UNIQUE_CARRIER</th>\n      <th>n_flights</th>\n      <th>arr_delay_mean</th>\n      <th>carrier_delay_mean</th>\n      <th>weather_delay_mean</th>\n      <th>nas_delay_mean</th>\n      <th>security_delay_mean</th>\n      <th>late_aircraft_delay_mean</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>OH</td>\n      <td>78476.0</td>\n      <td>17.155742</td>\n      <td>25.977062</td>\n      <td>5.957642</td>\n      <td>11.856888</td>\n      <td>0.116016</td>\n      <td>43.509299</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>F9</td>\n      <td>65965.0</td>\n      <td>11.316228</td>\n      <td>23.052504</td>\n      <td>1.914577</td>\n      <td>15.357855</td>\n      <td>0.000000</td>\n      <td>40.532712</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>G4</td>\n      <td>42596.0</td>\n      <td>9.537140</td>\n      <td>24.891197</td>\n      <td>8.928527</td>\n      <td>18.699918</td>\n      <td>0.681613</td>\n      <td>33.020979</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>AA</td>\n      <td>302790.0</td>\n      <td>8.978682</td>\n      <td>27.111256</td>\n      <td>4.613031</td>\n      <td>13.514676</td>\n      <td>0.107813</td>\n      <td>33.715386</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>OO</td>\n      <td>259692.0</td>\n      <td>7.590935</td>\n      <td>38.930567</td>\n      <td>12.113770</td>\n      <td>13.153948</td>\n      <td>0.097592</td>\n      <td>16.580470</td>\n    </tr>\n  </tbody>\n</table>\n</div>"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://0e28052ddd31:4040/jobs/job?id=7"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1779979757656_210864118","id":"paragraph_1779721879219_2120144174","dateCreated":"2026-05-28T14:49:17+0000","status":"FINISHED","dateFinished":"2026-05-28T14:51:32+0000","dateStarted":"2026-05-28T14:51:32+0000"},{"text":"%spark.pyspark\r\n\r\nimport matplotlib.pyplot as plt\r\n\r\n\r\ntop10 = df.sort_values('arr_delay_mean', ascending=False).head(10).copy()\r\ncauses = ['carrier_delay_mean','weather_delay_mean','nas_delay_mean','security_delay_mean','late_aircraft_delay_mean']\r\nplot_df = top10[['OP_UNIQUE_CARRIER'] + causes].set_index('OP_UNIQUE_CARRIER')\r\n\r\nfig, ax = plt.subplots(figsize=(10, 6))\r\nplot_df['arr_delay_mean'] = top10.set_index('OP_UNIQUE_CARRIER')['arr_delay_mean']\r\nplot_df['arr_delay_mean'].plot(kind='bar', ax=ax, color='#01696f')\r\nax.set_title('Top 10 compagnie per ritardo medio in arrivo')\r\nax.set_xlabel('Compagnia')\r\nax.set_ylabel('Ritardo medio in arrivo')\r\nax.grid(axis='y', alpha=0.3)\r\nplt.tight_layout()\r\nz.show(plt)\r\nplt.close()\r\n\r\nfig, ax = plt.subplots(figsize=(12, 7))\r\nplot_df[causes].plot(kind='bar', stacked=True, ax=ax, width=0.85)\r\nax.set_title('Incidenza media delle cause di ritardo per le top 10 compagnie')\r\nax.set_xlabel('Compagnia')\r\nax.set_ylabel('Ritardo medio per causa')\r\nax.grid(axis='y', alpha=0.3)\r\nax.legend(title='Causa di ritardo', bbox_to_anchor=(1.02, 1), loc='upper left')\r\nplt.tight_layout()\r\nz.show(plt)\r\nplt.close()\r\n\r\n","user":"anonymous","dateUpdated":"2026-05-28T14:52:02+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"},{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1779979757656_1020602249","id":"paragraph_1779715238963_1706231116","dateCreated":"2026-05-28T14:49:17+0000","